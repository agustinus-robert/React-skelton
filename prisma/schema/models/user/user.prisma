model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  name     String
  username String  @unique
  password String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  deleted_at DateTime?

  logtrail LogTrail[]
  userRole UserRole[]

  @@index([deleted_at])
  @@map("users")
}

model LogTrail {
  id        BigInt @id @default(autoincrement())
  model_name String
  model_type String
  action    String
  deleted_at DateTime?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id Int
  @@map("log_trails")
}

model UserRole {
    user_id Int
    role_id Int

    user User @relation(fields: [user_id], references: [id])
    role Role @relation(fields: [role_id], references: [id])

    @@id([user_id, role_id])
    @@map("user_roles")
}